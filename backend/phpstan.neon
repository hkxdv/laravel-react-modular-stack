includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:

    phpVersion: 80408

    parallel:
        maximumNumberOfProcesses: 4

    paths:
        - app
        - bootstrap/
        - config
        - Modules
        - ../database
        - public
        - routes

    excludePaths:
        - bootstrap/cache/

    level: max

    # Aliasado del DTO de auth presentado por módulos (Admin/Examples) para que
    # Core pueda declarar el tipo sin acoplarse a módulos concretos (REQ-A12).
    # S3 (AUTC-S3) amplía AuthPageProps a UserDto|null y simplifica esto.
    typeAliases:
        PresentedUserDto: 'Modules\Admin\App\DTO\StaffUserDto|Modules\Examples\App\DTO\TenantUserDto'

    tmpDir: bootstrap/cache/phpstan

    scanFiles:
        - ../packages/foundry-php-utils/src/helpers.php
