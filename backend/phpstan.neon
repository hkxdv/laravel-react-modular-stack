includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:

    phpVersion: 80408

    parallel:
        maximumNumberOfProcesses: 4

    paths:
        - app
        - bootstrap/
        - config
        - Modules
        - ../database
        - public
        - routes

    excludePaths:
        - bootstrap/cache/

    level: max

    tmpDir: bootstrap/cache/phpstan

    scanFiles:
        - ../packages/foundry-php-utils/src/helpers.php
